# =============================================================================
# POC Environment Template
# Usage: cp poc/.env.poc.template poc/.env.poc  then fill in your values
# NEVER commit .env.poc (excluded by .dockerignore + .gitignore)
# =============================================================================

# -- OpenAlgo / Flask ----------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
APP_KEY=CHANGE_ME_64_HEX_CHARS
API_KEY_PEPPER=CHANGE_ME_ANOTHER_64_HEX
HOST_SERVER=http://localhost:5000
FLASK_PORT=5000
FLASK_DEBUG=False
FLASK_ENV=production

# -- WebSocket proxy -----------------------------------------------------------
# CRITICAL: must be 0.0.0.0 inside container
# Default in websocket_proxy/server.py is 127.0.0.1 (loopback-only)
# Setting to 127.0.0.1 will silently break host->container WebSocket connections
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8765

# -- Broker selection ----------------------------------------------------------
# All broker code ships in image; this restricts which are active at runtime.
# To add a broker later: edit this line + docker restart (no rebuild needed).
VALID_BROKERS=zerodha,evermore,upstox
BROKER_NAME=zerodha

# Zerodha (kite.trade developer console)
BROKER_API_KEY=CHANGE_ME
BROKER_API_SECRET=CHANGE_ME

# Upstox OAuth redirect (must be registered in Upstox developer console)
REDIRECT_URL=http://localhost:5000/upstox/callback

# Evermore on-premise server (container must have LAN/VPN access to host)
EVERMORE_BASE_URL=http://192.168.6.164:16006

# ESB (unused in REST-only POC; set to suppress startup warnings)
ESB_BASE_URL=http://host.docker.internal:6001

# -- strategy-executor (Quarkus poc profile) -----------------------------------
# On Linux: host.docker.internal requires extra_hosts in compose (already set)
# On Mac/Windows Docker Desktop: resolves automatically
EXECUTOR_MYSQL_URL=jdbc:mysql://host.docker.internal:3306/executor_poc
EXECUTOR_MYSQL_USER=executor
EXECUTOR_MYSQL_PASS=CHANGE_ME
EXECUTOR_MYSQL_SCHEMA=executor_poc
KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:9092
STRATEGY_COMPOSER_URL=http://host.docker.internal:8092
ESB_CLIENT_URL=http://host.docker.internal:6001
MARKETDATA_SUBSCRIPTION_URL=http://host.docker.internal:8081

# -- Timezone ------------------------------------------------------------------
TZ=Asia/Kolkata

# -- Mock feed (documentation only) -------------------------------------------
# External mock feed server pushes ticks to: http://<this-host>:7012/api/marketdata/tick
# MOCK_FEED_URL=http://192.168.X.X:XXXX
