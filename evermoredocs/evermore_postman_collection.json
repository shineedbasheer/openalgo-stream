					},
					"response": []
				},
				{
					"name": "ModifyRequest",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"",
									"pm.test(\"Response status is 200\", function() {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Order modified successfully\", function() {",
									"    pm.expect(jsonData.IntOrdNo).to.be.above(0);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"Uniqueid\": {{unique_id}},\n    \"RefNo\": \"{{ref_no}}\",\n    \"IntordNo\": {{int_ord_no}},\n    \"qty\": 1,\n    \"qtydisclosed\": 0,\n    \"Price\": 2.00,\n    \"TriggerPrice\": 0,\n    \"Booktype\": \"RL\",\n    \"Validity\": \"DAY\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/PublicAPI/ModifyRequest",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"PublicAPI",
								"ModifyRequest"
							]
						},
						"description": "Modify an existing open order. Changes the price from 1.00 to 2.00. Verifies that IntOrdNo > 0 in the response."
					},
					"response": []
				},
				{
					"name": "CancelRequest",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
