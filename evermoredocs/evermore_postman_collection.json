									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Order cancelled successfully\", function() {",
									"    pm.expect(jsonData.IntOrdNo).to.be.above(0);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"UniqueId\": {{unique_id}},\n    \"RefNo\": \"{{ref_no}}\",\n    \"IntOrdNo\": {{int_ord_no}}\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/PublicAPI/CancelRequest",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"PublicAPI",
								"CancelRequest"
							]
						},
						"description": "Cancel an existing open order by its internal order number. Verifies that IntOrdNo > 0 in the response."
					},
					"response": []
				}
			],
			"description": "Order management endpoints: place, check status, modify, and cancel orders."
		},
